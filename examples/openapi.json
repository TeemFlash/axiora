{
  "openapi": "3.0.3",
  "info": {
    "title": "Axiora local lab example",
    "version": "1.0.0",
    "description": "Example API inventory. Importing this document does not start a server or send requests."
  },
  "servers": [
    {"url": "http://127.0.0.1:8080"}
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {"description": "Service is available"}
        }
      }
    },
    "/devices": {
      "get": {
        "summary": "List laboratory devices",
        "operationId": "listDevices",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
          }
        ],
        "responses": {
          "200": {"description": "Device inventory"},
          "401": {"description": "Authentication required"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer"}
    }
  }
}
