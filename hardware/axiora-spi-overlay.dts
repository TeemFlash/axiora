// Raspberry Pi 5 / RP1. Linux owns every CS on the shared SPI bus.
/dts-v1/;
/plugin/;
/ {
    compatible = "brcm,bcm2712";
    fragment@0 {
        target = <&spi0>;
        __overlay__ {
            status = "okay";
            #address-cells = <1>;
            #size-cells = <0>;
            // Exclude the default hardware-CS pin group (GPIO7/8).
            pinctrl-0 = <&spi0_pins>;
            num-cs = <5>;
            cs-gpios = <&gpio 5 1>, <&gpio 6 1>, <&gpio 7 1>, <&gpio 8 1>, <&gpio 16 1>;
            spidev@0 { reg = <0>; status = "okay"; spi-max-frequency = <1000000>; };
            spidev@1 { reg = <1>; status = "okay"; spi-max-frequency = <1000000>; };
            // Raspberry Pi kernel explicitly supports this spidev compatible.
            spidev@2 {
                compatible = "spidev";
                reg = <2>;
                spi-max-frequency = <500000>;
                status = "okay";
            };
            ethernet@3 {
                compatible = "wiznet,w5500";
                reg = <3>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio>;
                interrupts = <24 8>;
                status = "okay";
            };
            axiora_touch: touchscreen@4 {
                compatible = "ti,ads7846";
                reg = <4>;
                spi-max-frequency = <1000000>;
                interrupt-parent = <&gpio>;
                interrupts = <21 2>;
                pendown-gpio = <&gpio 21 1>;
                ti,x-min = /bits/ 16 <0>;
                ti,y-min = /bits/ 16 <0>;
                ti,x-max = /bits/ 16 <4095>;
                ti,y-max = /bits/ 16 <4095>;
                ti,pressure-max = /bits/ 16 <65535>;
                ti,x-plate-ohms = /bits/ 16 <400>;
                status = "okay";
            };
        };
    };
    fragment@1 {
        target = <&gpio>;
        __overlay__ {
            axiora-w5500-reset {
                gpio-hog;
                gpios = <25 0>;
                output-high;
                line-name = "axiora-w5500-reset-release";
            };
        };
    };
    __overrides__ {
        touch = <&axiora_touch>, "status";
        swapxy = <&axiora_touch>, "touchscreen-swapped-x-y?";
        invx = <&axiora_touch>, "touchscreen-inverted-x?";
        invy = <&axiora_touch>, "touchscreen-inverted-y?";
    };
};
